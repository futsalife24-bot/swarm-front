{
  "name": "swarm-front-local",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "GATE", "class_name": "Gate" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Gate"] }],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5186,http://localhost:5186,http://127.0.0.1:4173",
  },
}
