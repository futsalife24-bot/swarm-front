{
  "schema": 1,
  "method": {
    "rafWindow": "raw.framesの先頭1件はbegin()前から続く間隔なので常に除外",
    "longFrameWindow": "raw.longFramesはms>=durationMsかつ有限・非負の記録のみ採用（frame開始も計測窓内）",
    "negativeRelativeTimes": "inputEvents、inputWindowEvents、application ACK、full-frame-only ACKの相対ms/sentMsが負または非有限なら除外。件数はclient.excluded",
    "inputGaps": "隣接inputEventsの両方がcombat/boss、同じphaseとresumeUntil、serverNow>resumeUntil+1秒",
    "outsideResumeGraceAckZero": "samplesのうち同じ猶予外条件でack===0の件数",
    "releaseNeutralToReceiptAckMs": "releaseAfter以降の最初のfire=falseかつmoving=falseから、同seq以上で入力採取時刻と照合できる最初のinputWindow.acknowledgeまで",
    "receiptAckMs": "inputWindowEventsのseqをinputEventsの同seq送信msへ厳密対応させた受理RTT。対応不能は除外",
    "fullFrameOnlyReceiptAckMs": "旧receiptAckEventsはtype=stateだけを見る参考値。delta/inputReceiptは含まない",
    "wireBytes": "計測中の受信JSON payloadのみ。WebSocket等のプロトコルoverheadは含まない",
    "aggregateDownlinkBytesPerSecond": "4人のwire.bytes合計 / client.wallMsの最大値",
    "comparison": "trial間は同一スマホ比較ではない",
    "terrainAlignment": "旧mixed-render1-profile/mixed-render4はserver側だけ草原へ換装しclient側と不一致。主比較から除く"
