{
  "name": "swarm-room-id-local-only",
  "main": "tests/fixtures/room-id-worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
      {
        "name": "GATE",
        "class_name": "RoomIdTestGate",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room", "RoomIdTestGate"],
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://127.0.0.1:5202",
  },
}
