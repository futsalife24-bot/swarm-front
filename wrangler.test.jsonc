{
  "name": "swarm-front-fixtures-local",
  "main": "server/testing.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "send_metrics": false,
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "TestRoom" },
      { "name": "GATE", "class_name": "TestGate" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TestRoom", "TestGate"] },
  ],
  "vars": { "ALLOWED_ORIGINS": "http://127.0.0.1:5186" },
}
