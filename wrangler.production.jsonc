{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarm-front",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "send_metrics": false,
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEqP4GMKnl-xNQKK"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "GATE", "class_name": "Gate" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Gate"] }],
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
}
